# Test-Dockerfile
FROM nvidia/cuda:11.8.0-cudnn8-devel-ubuntu22.04

# DNS Debug
RUN cat /etc/resolv.conf
RUN nslookup archive.ubuntu.com || true
RUN ping -c 3 8.8.8.8 || true

# Einfacher Test
RUN apt-get update || echo "Update failed"
RUN apt-get install -y curl || echo "Install failed"

CMD ["echo", "Test successful"]